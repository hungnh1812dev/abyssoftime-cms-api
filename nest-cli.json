{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "prisma/application/client/**/*",
        "outDir": "dist/src"
      },
      {
        "include": "modules/auth/infrastructure/email/templates/handlebars/**/*.hbs",
        "outDir": "dist/src"
      }
    ]
  }
}
